# ZEMP API — copy to .env and adjust. Never commit a real .env.
NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Session lifetime in hours (sliding: renewed on each authenticated request).
SESSION_TTL_HOURS=12

# Set to true behind HTTPS so session cookies carry the Secure attribute.
COOKIE_SECURE=false

# Organization time zone used when the store is first seeded.
ORG_TIME_ZONE=Asia/Kolkata

# Requests per minute per client: global, and the tighter limit for auth endpoints.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Phase C: PostgreSQL connection string used by Prisma.
# DATABASE_URL=postgresql://user:password@localhost:5432/zemp

# Email reminders (task assigned/reassigned/blocked/due-soon/overdue). Leave SMTP_HOST unset to
# run without sending real email — reminders still generate, they just log instead of delivering.
# Any SMTP provider works: Gmail (smtp.gmail.com, app password), SendGrid, AWS SES, Resend, Mailtrap.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ZEMP <notifications@yourdomain.com>"
