{
  "name": "@zemp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZEMP API — NestJS REST backend for /api/v1",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "prisma migrate deploy && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"backend tests land in Phase E\" && exit 0",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@zemp/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
