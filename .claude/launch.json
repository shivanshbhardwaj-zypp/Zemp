{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zemp-frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@zemp/frontend", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "zemp-db",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@zemp/backend", "db:local"],
      "port": 55432
    },
    {
      "name": "zemp-backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@zemp/backend", "dev"],
      "port": 4000
    }
  ]
}
