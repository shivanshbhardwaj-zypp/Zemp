{
  "name": "zemp",
  "version": "0.1.0",
  "private": true,
  "description": "ZEMP — internal employee, team, task and reporting platform",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "shared:build": "pnpm --filter @zemp/shared build",
    "dev": "pnpm shared:build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm shared:build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
