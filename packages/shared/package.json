{
  "name": "@zemp/shared",
  "version": "0.1.0",
  "private": true,
  "description": "ZEMP domain rules, validation schemas and API contracts shared by frontend and backend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
